    <string name="pref_import_configuration_name">Importar configurações</string>
    <string name="pref_import_configuration_desc">Importe um arquivo zip de configuração do Syncthing existente.</string>
    <string name="pref_export_configuration_name">Exportar configuração</string>
    <string name="pref_export_configuration_desc">Exporte a configuração atual do Syncthing para um arquivo zip.</string>
    <string name="pref_service_status_name">Status do Syncthing</string>
    <string name="pref_auto_mode_name">Modo automático</string>
    <string name="pref_auto_mode_desc">Inicia e para automaticamente com base nas condições especificadas.</string>
    <string name="pref_network_conditions_name">Condições da rede</string>
    <string name="pref_network_conditions_desc">Executa quando conectado a determinados tipos de rede ou redes Wi-Fi.</string>
    <string name="pref_run_on_battery_name">Execução com energia da bateria.</string>
    <string name="pref_run_on_battery_desc">O Syncthing é executado quando o dispositivo está funcionando com bateria e o nível da bateria é de pelo menos %1$d%%. O Syncthing sempre é executado quando conectado à tomada.</string>
    <string name="pref_respect_battery_saver_name">Respeitar o modo de economia de bateria.</string>
    <string name="pref_respect_battery_saver_desc">Só funciona quando o modo de economia de bateria do Android estiver desativado.</string>
    <string name="pref_respect_auto_sync_data_name">Respeitar a configuração de sincronização automática de dados</string>
    <string name="pref_respect_auto_sync_data_desc">Executar somente quando a configuração de sincronização automática de dados do Android estiver ativada.</string>
    <string name="pref_sync_schedule_settings_name">Sincronia agendada</string>
    <string name="pref_sync_schedule_settings_desc">Executa o Syncthing periodicamente com base em um intervalo de tempo fixo.</string>
    <string name="pref_keep_alive_name">Mantenha o Syncthing ativo</string>
    <string name="pref_keep_alive_desc">Quando o Syncthing não deve ser executado, pause-o em vez de fechá-lo. Isso evita uma possível queda de desempenho ao verificar pastas grandes na inicialização.</string>
    <string name="pref_remote_control_name">Permitir acesso remoto</string>
    <string name="pref_remote_control_desc">Permita que aplicativos externos alternem para o modo automático ou iniciem e parem o Syncthing manualmente.</string>
    <string name="pref_allow_auto_mode_name">Permitir modo automático</string>
    <string name="pref_allow_auto_mode_desc">Quando desativado, todo o modo automático é completamente removido do aplicativo, das notificações e do bloco de configurações rápidas.</string>
    <string name="pref_show_exit_name">Mostrar botão para sair</string>
    <string name="pref_show_exit_desc">Exibir um botão Sair na notificação persistente. O aplicativo será reiniciado automaticamente após uma reinicialização ou ao receber um comando vindo de um acesso remoto.</string>
    <string name="pref_show_details_name">Notificações detalhadas</string>
    <string name="pref_show_details_desc">Exiba o status das pastas compartilhadas e dos dispositivos conectados na notificação persistente.</string>
    <string name="pref_start_on_boot_name">Iniciar na inicialização</string>
    <string name="pref_start_on_boot_desc">Iniciar o aplicativo automaticamente após a reinicialização.</string>
    <string name="pref_version_name">Versão</string>
    <string name="pref_save_logs_name">Salvar registros</string>
    <string name="pref_save_logs_desc">Salvar os registros do logcat em um arquivo.</string>
    <string name="pref_conflicts_info">Os seguintes arquivos apresentaram conflitos durante a sincronização e precisam ser resolvidos manualmente. Selecione um arquivo para abrir seu diretório pai no gerenciador de arquivos do sistema.</string>
    <string name="pref_header_allowed_network_types">Tipos de rede permitidos</string>
    <string name="pref_header_allowed_wifi_networks">Redes Wi-Fi permitidas</string>
    <string name="pref_header_available_wifi_networks">Redes Wi-Fi disponíveis</string>
    <string name="pref_require_unmetered_network_name">Exigir limite de rede sem consumo de dados</string>
    <string name="pref_network_allow_wifi_name">Permitir Wi-Fi</string>
    <string name="pref_network_allow_cellular_name">Permitir dados móveis</string>
    <string name="pref_network_allow_roaming_name">Permitir dados móveis (roaming)</string>
    <string name="pref_network_allow_ethernet_name">Permitir ethernet</string>
    <string name="pref_network_allow_other_name">Permitir outras interfaces de rede</string>
    <string name="pref_location_optional_info">As permissões de localização são opcionais e só são necessárias ao restringir as redes Wi-Fi permitidas. Mesmo que as permissões sejam concedidas, elas não serão usadas a menos que haja redes Wi-Fi permitidas configuradas.</string>
    <string name="pref_allow_precise_location_name">Permitir acesso preciso à localização</string>
    <string name="pref_allow_precise_location_desc">Necessário para acessar os detalhes da conexão Wi-Fi.</string>
    <string name="pref_allow_background_location_name">Permitir acesso à localização em segundo plano</string>
    <string name="pref_allow_background_location_desc">Necessário para acessar os detalhes da conexão Wi-Fi em segundo plano.</string>
    <string name="pref_wifi_networks_info">Ao usar Wi-Fi, execute o programa somente se estiver conectado à rede especificada. Se nenhuma rede for especificada, todas as redes serão permitidas.</string>
    <string name="pref_add_wifi_network_name">Adicionar rede Wi-Fi manualmente</string>
    <string name="pref_sync_schedule_name">Sincronizar conforme agendamento</string>
    <string name="pref_sync_schedule_desc">Sincronizar por %2$s durante cada janela de %1$s.</string>
    <string name="pref_sync_schedule_idle_name">Pare mais cedo quando estiver ocioso</string>
    <string name="pref_sync_schedule_idle_desc">Stop Syncthing before the sync window ends if at least one device connected and all folders have been idle for %1$s.</string>
    <string name="pref_sync_schedule_battery_only_name">Use a programação de tempo somente quando a bateria estiver funcionando.</string>
    <string name="pref_sync_schedule_battery_only_desc">Quando conectado, o cronograma será ignorado.</string>
