    <string name="pref_inhibit_battery_opt_name">Desativar otimização de bateria</string>
    <string name="pref_inhibit_battery_opt_desc">Necessário para funcionar de forma confiável em segundo plano.</string>
    <string name="pref_allow_notifications_name">Permitir notificações</string>
    <string name="pref_allow_notifications_desc">Necessário para funcionar de forma confiável em segundo plano e para iniciar e parar o Syncthing.</string>
    <string name="pref_allow_local_network_name">Permitir acesso à rede local</string>
    <string name="pref_allow_local_network_desc">Era necessário conectar-se diretamente aos dispositivos na rede local, em vez de usar os servidores de retransmissão do Syncthing.</string>
    <string name="pref_local_storage_access_name">Permitir acesso ao armazenamento local</string>
    <string name="pref_local_storage_access_desc">Necessário para que o Syncthing tenha acesso direto aos arquivos de armazenamento interno e externo.</string>
    <string name="pref_saf_folder_access_name">Permitir acesso à pastas</string>
    <string name="pref_disable_app_hibernation_name">Desabilitar hibernação do aplicativo</string>
    <string name="pref_disable_app_hibernation_desc">Necessário para impedir que o Android remova automaticamente as permissões do aplicativo após um determinado período de tempo.</string>
    <string name="pref_open_web_ui_name">Abrir interface web</string>
    <string name="pref_open_web_ui_desc">Abra a interface de configuração web do Syncthing.</string>
    <string name="pref_conflicts_name">Conflitos de sincronização</string>
    <plurals name="pref_conflicts_desc">
        <item quantity="one">%d arquivo apresentou conflito durante a sincronização.</item>
        <item quantity="many">%d arquivos apresentaram conflitos durante a sincronização.</item>
