    <string name="dialog_storage_type_saf_title">Framework de acesso ao armazenamento</string>
    <string name="dialog_storage_type_saf_desc">Concede permissões apenas à pasta selecionada, mas é mais lento e pode resultar em erros de sincronização inesperados.</string>
