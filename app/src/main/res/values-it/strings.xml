    <string name="pref_location_optional_info">I permessi della posizione sono facoltativi e sono necessari solo quando si restringono le reti Wi-Fi consentite. Se il permesso è concesso, sarà usato solo quando sono configuate delle reti Wi-Fi consentite.</string>
    <string name="pref_allow_precise_location_name">Consenti accesso alla posizione esatta</string>
    <string name="pref_allow_precise_location_desc">Necessario per accedere ai dettagli della rete Wi-Fi.</string>
    <string name="pref_allow_background_location_name">Consenti accesso alla posizione in background</string>
    <string name="pref_allow_background_location_desc">Necessario per accedere ai dettagli della rete Wi-Fi in background.</string>
    <string name="pref_wifi_networks_info">Quando si usa il Wi-Fi, esegui Syncthing solo sulle reti specificate. Se nessuna rete è specificata, allora tutte le reti sono consentite.</string>
