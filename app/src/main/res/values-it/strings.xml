    <string name="pref_auto_mode_name">Modalità automatica</string>
    <string name="pref_auto_mode_desc">Esegui Syncthing automaticamente in base alle condizioni specificate.</string>
    <string name="pref_network_conditions_name">Condizioni di rete</string>
    <string name="pref_network_conditions_desc">Esegui Syncthing solo su certi tipi di connessione o reti Wi-Fi.</string>
    <string name="pref_run_on_battery_name">Esegui Syncthing su batteria</string>
    <string name="pref_run_on_battery_desc">Esegui Syncthing quando il dispositivo è alimentato dalla batteria ed ha almeno il %1$d%% di carica. La sincronizzazione è sempre attiva quando il dispositivo è in carica.</string>
    <string name="pref_respect_battery_saver_name">Rispetta la modalità di risparmio batteria</string>
    <string name="pref_respect_battery_saver_desc">Esegui Syncthing solo quando la modalità risparmio batteria è disabilitata.</string>
    <string name="pref_respect_auto_sync_data_name">Rispetta l\'impostazione di sincronizzazione automatica</string>
    <string name="pref_respect_auto_sync_data_desc">Esegui Syncthing solo quando l\'impostazione di sincronizzazione automatica di Android è abilitata.</string>
    <string name="pref_sync_schedule_settings_name">Piano di sincronizzazione</string>
    <string name="pref_sync_schedule_settings_desc">Esegui Syncthing periodicamente in base a un intervallo di tempo fisso.</string>
    <string name="pref_keep_alive_name">Mantieni in vita Syncthing</string>
    <string name="pref_keep_alive_desc">Quando Syncthing non deve essere eseguito, mettilo in pausa invece di arrestarlo. Potrebbe prevenire un calo di prestazioni dovuto alla scansione all\'avvio di cartelle di grandi dimensioni.</string>
    <string name="pref_remote_control_name">Consenti controllo remoto</string>
    <string name="pref_remote_control_desc">Consenti ad altre app di passare alla modalità automatica o di avviare e fermare manualmente Syncthing.</string>
    <string name="pref_allow_auto_mode_name">Consenti modalità automatica</string>
    <string name="pref_allow_auto_mode_desc">Se disabilitato, tutta la funzionalità automatica è completamente rimossa dall\'app, incluse le notifiche, e le impostazioni rapide.</string>
    <string name="pref_show_exit_name">Mostra pulsante Esci</string>
    <string name="pref_show_exit_desc">Mostra il pulsante Esci nella notifica persistente. L\'app si avvierà di nuovo automaticamente dopo un riavvio o ricevendo un comando di controllo remoto.</string>
    <string name="pref_show_details_name">Notifiche dettagliate</string>
    <string name="pref_show_details_desc">Mostra lo stato delle cartelle condivise e dei dispositivi connessi nella notifica persistente.</string>
    <string name="pref_start_on_boot_name">Avvia automaticamente</string>
    <string name="pref_start_on_boot_desc">Avvia Syncthing automaticamente dopo il riavvio del dispositivo.</string>
    <string name="pref_version_name">Versione</string>
    <string name="pref_save_logs_name">Salva i log</string>
